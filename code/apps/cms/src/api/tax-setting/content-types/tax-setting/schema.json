{
  "kind": "singleType",
  "collectionName": "tax_setting",
  "info": {
    "singularName": "tax-setting",
    "pluralName": "tax-settings",
    "displayName": "Tax Setting",
    "description": "Flat sales-tax rate applied at checkout. Enter a percentage value (e.g. 1.3 for 1.3%)."
  },
