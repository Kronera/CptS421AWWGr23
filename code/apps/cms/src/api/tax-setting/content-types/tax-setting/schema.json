    "ratePercent": {
      "type": "decimal",
      "default": 0,
      "min": 0,
      "required": true
    },
    "label": {
      "type": "string",
      "default": "Sales Tax"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  }
}
