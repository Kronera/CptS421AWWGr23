{
  "kind": "collectionType",
  "collectionName": "contact_messages",
  "info": {
    "singularName": "contact-message",
    "pluralName": "contact-messages",
    "displayName": "Contact Message"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "subject": {
      "type": "string"
    },
    "inquiryType": {
      "type": "enumeration",
      "enum": [
        "general",
        "partnership",
        "volunteer",
        "media",
        "donation",
        "events"
      ],
      "default": "general"
    },
    "message": {
      "type": "text",
      "required": true
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "readAt": {
      "type": "datetime"
    }
  }
}
